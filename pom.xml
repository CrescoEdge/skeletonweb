<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.cresco</groupId>
    <artifactId>skeletonweb</artifactId>
    <version>1.3-SNAPSHOT</version>

    <name>Cresco Skeleton Web</name>
    <description>Template Cresco plugin that serves a JAX-RS (Jersey) web app from an embedded Jetty 12 server</description>
    <url>https://github.com/CrescoEdge/skeletonweb</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/CrescoEdge/skeletonweb.git</connection>
        <developerConnection>scm:git:git://github.com/CrescoEdge/skeletonweb.git</developerConnection>
        <url>https://github.com/CrescoEdge/skeletonweb</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.bundle.plugin.version>5.1.9</maven.bundle.plugin.version>

        <!-- Jetty 9.4 is end-of-life; Jetty 12 serves jakarta.servlet 6 through the ee10 environment. -->
        <jetty.version>12.1.14</jetty.version>
        <!-- Jersey 3.1 = Jakarta REST 3.1 on jakarta.servlet; works on Jetty 12 ee10. -->
        <jersey.version>3.1.12</jersey.version>
    </properties>

    <dependencies>

        <!-- OSGi R8 API (provided by the Cresco agent's Felix framework) -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <version>8.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.annotation</artifactId>
            <version>6.0.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>1.5.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.cm</artifactId>
            <version>1.6.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Cresco plugin SPI (provided by the agent) -->
        <dependency>
            <groupId>io.cresco</groupId>
            <artifactId>library</artifactId>
            <version>1.3-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Embedded web server: Jetty 12 core + ee10 servlet environment -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-server</artifactId>
            <version>${jetty.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>${jetty.version}</version>
        </dependency>

        <!-- JAX-RS (Jakarta REST) via Jersey on the servlet container -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet-core</artifactId>
            <version>${jersey.version}</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <version>${jersey.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Build the OSGi bundle with: mvn clean package bundle:bundle -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>${maven.bundle.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>Cresco Skeleton Web</Bundle-Name>
                        <Bundle-Description>Template Cresco plugin serving a Jersey web app from embedded Jetty 12</Bundle-Description>
                        <Bundle-Vendor>Cresco.io</Bundle-Vendor>
                        <Bundle-Version>${project.version}-${maven.build.timestamp}</Bundle-Version>
                        <Bundle-Activator>io.cresco.skeletonweb.Activator</Bundle-Activator>
                        <!-- Cresco SPI, framework and Config Admin are hard requirements; everything else
                             (embedded Jetty/Jersey optional imports) stays optional. -->
                        <Import-Package>
                            org.osgi.framework,
                            org.osgi.framework.*,
                            org.osgi.service.cm,
                            io.cresco.library.*,
                            *;resolution:=optional
                        </Import-Package>
                        <!-- Self-contained: embed the Jetty 12 + Jersey 3 closure (Embed-Transitive pulls
                             jetty-util/http/io, jakarta.servlet/ws.rs/inject, hk2 ...). slf4j-api is NOT
                             embedded: the framework exports SLF4J 2.x, so Jetty's logging lands in the
                             agent log. scope=compile|runtime keeps provided jars (OSGi, library) out. -->
                        <Embed-Transitive>true</Embed-Transitive>
                        <Embed-Dependency>!org.osgi.*;!osgi.cmpn.*;!library;!slf4j-api;*;scope=compile|runtime</Embed-Dependency>
                    </instructions>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>allow-snapshots</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <repositories>
                <repository>
                    <id>central-portal-snapshots</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots</url>
                    <releases><enabled>false</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

</project>
